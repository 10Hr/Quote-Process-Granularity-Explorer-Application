<Window x:Class="ZSExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZSExplorer"
        mc:Ignorable="d"
        Title="ZSExplorer" Height="600" Width="1000">

    <DockPanel>

        <!-- Top Panel -->
        <Grid DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Height="40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center" Margin="8,0,10,0">
                    <TextBlock Text="Add Contract: "
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{StaticResource ButtonTextBrush}"
                               VerticalAlignment="Center" />

                    <ComboBox
                        Width="200"
                        Margin="8,0,0,0"
                        Height="26"
                        IsEditable="False"
                        IsTextSearchEnabled="True"
                        StaysOpenOnEdit="True"
                        ItemsSource="{Binding UniqueSymbols}"
                        SelectedItem="{Binding SelectedSymbol}"
                        IsEnabled="{Binding FileLoaded}" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="Add KS Test"
                            Command="{Binding AddKsTestCommand}"
                            IsEnabled="{Binding FileLoaded}" />
                </StackPanel>

            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Content Area -->
        <Grid DockPanel.Dock="Top" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Border Grid.Column="0" Margin="10" BorderBrush="Gray" BorderThickness="2" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Data Summary -->
                    <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Data Summary" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding QuoteCount, StringFormat=Total Quote Count: {0}}"/>
                            <TextBlock Text="{Binding DateRange, StringFormat=Date Range: {0}}"/>
                            <TextBlock Text="{Binding UniqueContractCount, StringFormat=Unique Contract Count: {0}}"/>
                            <TextBlock Text="{Binding ExchangeCount, StringFormat=Exchange Count: {0}}"/>

                            <Rectangle Height="20" Fill="Transparent"/>

                            <Button Content="Load Feather Data"
                                    Width="150"
                                    Height="35"
                                    Command="{Binding LoadFeatherDataCommand}" />

                            <TextBlock Text="{Binding FileLoadSummary}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Global Settings -->
                    <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="10">
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="Global Settings" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Distribution Method:" FontWeight="SemiBold" Width="140"/>
                                <TextBlock Text="Regula Falsi Method" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Alpha Level:" FontWeight="SemiBold" Width="140"/>
                                <TextBlock Text="α = 0.05 (Fixed)" />
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- Export Options -->
                    <Border Grid.Row="3" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="10">
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="Export Options" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="Export All Results (md)"
                                        Height="30"
                                        Command="{Binding ExportMarkdownCommand}"
                                        Margin="0,0,10,0"/>

                                <Button Content="Export ECDF Plots (png)"
                                        Height="30"
                                        Command="{Binding ExportPlotsCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Calls & Puts Grids -->
                    <Border Grid.Row="4" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="10">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0" Grid.Row="0"
                                       Text="Call Data"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#FF2C3E50"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,5" />

                            <TextBlock Grid.Column="1" Grid.Row="0"
                                       Text="Put Data"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#FF2C3E50"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,5" />

                            <!-- Calls -->
                            <DataGrid 
                                Grid.Column="0" Grid.Row="1"
                                AutoGenerateColumns="False"
                                AutoGeneratingColumn="MarketDataGridAutoGeneratingColumn"
                                ItemsSource="{Binding Calls}"
                                CanUserAddRows="False"
                                Margin="0,0,10,0">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="DateTime" Binding="{Binding DateTime, StringFormat=MM/dd/yyyy HH:mm:ss.ffffff}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="MMID" Binding="{Binding MMID}" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Header="BidAsk" Binding="{Binding BidAsk}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Puts -->
                            <DataGrid 
                                Grid.Column="1" Grid.Row="1"
                                ItemsSource="{Binding Puts}"
                                AutoGenerateColumns="False"
                                AutoGeneratingColumn="MarketDataGridAutoGeneratingColumn"
                                CanUserAddRows="False">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="DateTime" Binding="{Binding DateTime, StringFormat=MM/dd/yyyy HH:mm:ss.ffffff}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="MMID" Binding="{Binding MMID}" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Header="BidAsk" Binding="{Binding BidAsk}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>

                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <!-- Right Panel -->
            <ContentControl Name="RightPanelContainer" Grid.Column="1" Margin="10" Content="{Binding RightPanelContainer}"/>

        </Grid>
    </DockPanel>

</Window>

