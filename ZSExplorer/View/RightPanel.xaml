<UserControl x:Class="ZSExplorer.RightPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d"
             MinWidth="350"
             Background="White">

    <Border BorderBrush="{StaticResource PrimaryBrush}"
            BorderThickness="2"
            CornerRadius="8"
            Padding="10"
            Margin="5">

        <!-- ENTIRE PANEL SCROLLS -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- ================= HEADER ================= -->
                <Border Background="{StaticResource PrimaryBrush}"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,0,10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding ContractSymbolText}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="White"/>

                            <TextBlock Text="{Binding OptionDetailsText}"
                                       FontSize="12"
                                       Foreground="White"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Ellipse Width="14"
                                     Height="14"
                                     Fill="{Binding StatusIndicatorBrush}"
                                     Margin="0,0,10,0"/>

                            <Button Content="Remove"
                                    Padding="10,2"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Background="{StaticResource PrimaryPressedBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding RemoveKsTestCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= CONTROLS ================= -->
                <Grid Margin="0,0,0,10" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" SharedSizeGroup="Col"/>
                        <ColumnDefinition Width="*" SharedSizeGroup="Col"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">

                        <TextBlock Text="Log Return Time Window"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <TextBlock Text="Return Calculation Window (Seconds)"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,6"/>

                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220"
                                    Minimum="{Binding TimeWindowSliderMinimum}"
                                    Maximum="{Binding TimeWindowSliderMaximum}"
                                    Value="{Binding TimeWindowSliderValue,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                                    TickFrequency="1"
                                    IsMoveToPointEnabled="True"/>

                            <TextBox Width="70"
                                     Margin="8,0,0,0"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding MicrosecondInputText,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Width="50" Text="{Binding TimeLabel0Text}"/>
                            <TextBlock Width="50" TextAlignment="Center" Text="{Binding TimeLabel25Text}"/>
                            <TextBlock Width="50" TextAlignment="Center" Text="{Binding TimeLabel50Text}"/>
                            <TextBlock Width="50" TextAlignment="Center" Text="{Binding TimeLabel75Text}"/>
                            <TextBlock Width="50" TextAlignment="Right" Text="{Binding TimeLabel100Text}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <CheckBox Content="Use Bid Ask"
                                      Margin="0,0,10,0"
                                      IsChecked="{Binding UseBidPrices}"/>

                            <CheckBox Content="Analyze All Call or Put Options"
                                      IsChecked="{Binding AnalyzeAllOptions}"/>
                        </StackPanel>

                        <!-- <TextBlock Margin="0,6,0,10"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding TimeWindowValueText}"/> -->

                        <TextBlock Text="Sample Statistics"
                                   FontWeight="Bold"
                                   Margin="0,10,0,6"/>

                        <UniformGrid Columns="2" Rows="3">
                            <TextBlock Text="Sample Size:"/>
                            <TextBlock Text="{Binding SampleSizeText}"/>

                            <TextBlock Text="Mean Return:"/>
                            <TextBlock Text="{Binding MeanReturnText}"/>

                            <TextBlock Text="Std Dev:"/>
                            <TextBlock Text="{Binding StdDevText}"/>
                        </UniformGrid>
                    </StackPanel>

                    <!-- RIGHT -->
                    <StackPanel Grid.Column="1">

                        <TextBlock Text="Fitted Distribution Parameters"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>

                        <UniformGrid Columns="2" Rows="3">
                            <TextBlock Text="Location:"/>
                            <TextBlock Text="{Binding LocationParamText}"/>

                            <TextBlock Text="Scale:"/>
                            <TextBlock Text="{Binding ScaleParamText}"/>

                            <TextBlock Text="DoF:"/>
                            <TextBlock Text="{Binding DegreesFreedomText}"/>
                        </UniformGrid>

                        <Border Margin="0,10,0,0"
                                Padding="8"
                                Background="#FFF9F2D6"
                                BorderBrush="{StaticResource SecondaryBrush}"
                                BorderThickness="1"
                                CornerRadius="6">

                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Foreground="Red"
                                           FontWeight="Bold"
                                           Text="{Binding InsufficientDataText}"/>

                                <TextBlock Text="KS Test Results"
                                           FontWeight="Bold"
                                           Margin="0,6,0,4"/>

                                <TextBlock Text="{Binding KsTestStatText}"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding StatDecisionText}"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding PValueText}"
                                           FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ================= PLOT (FIXED, VIEWABLE) ================= -->
                <Border BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="White"
                        Margin="0,0,0,10">

                    <oxy:PlotView Height="420"
                                  Margin="10"
                                  Model="{Binding ECDFPlotModel}"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
